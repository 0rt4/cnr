pkgname=linux-neko-zen
version=7.2
revision=6
short_desc="Custom Zen kernel 7.2 precompiled for Void Linux"
maintainer="JavierC"
license="GPL-2.0-only"
homepage="https://github.com/Neko-Void-Linux/kernel-neko-void"
distfiles="https://github.com/Neko-Void-Linux/kernel-neko-void/releases/download/latest/zen-kernel-void-7.2.6-zen-neko.tar.gz"
checksum="c7cc9f4a1c7eb247f1907dba27d3b30f8d16a2c4df777c7678c9c714e58f3dd0"
create_wrksrc=yes
triggers="kernel-hooks"
kernel_hooks_version="7.2.6-zen-neko+"
do_install() {
    vmkdir boot
    vmkdir usr/lib/modules
    vmkdir usr/src
    cp -a boot/* ${DESTDIR}/boot/
    cp -a lib/modules/* ${DESTDIR}/usr/lib/modules/
    cp -a usr/src/* ${DESTDIR}/usr/src/
}
