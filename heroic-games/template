# Template file for 'heroic-games-launcher-bin'
pkgname=heroic-games
version=2.22.2
revision=1
archs="x86_64"
build_style=fetch
short_desc="Open Source Launcher for GOG, Epic Games and Amazon Games"
maintainer="Javiercplus"
hostmakedepends="binutils tar xz"
license="GPL-3.0-only"
homepage="https://heroicgameslauncher.com"
distfiles="https://github.com/Heroic-Games-Launcher/HeroicGamesLauncher/releases/download/v${version}/Heroic-${version}-linux-x64.tar.xz"
checksum=5a1665db55078ab4c070ccadaa46ed4c68f7cdb676d01a0d795256716f3e7e25

# Dependencias mapeadas de Debian a Void Linux
depends="gtk+3 libnotify nss libXScrnSaver libXtst xdg-utils at-spi2-core libuuid libsecret"

# Evita que XBPS intente modificar los binarios ya compilados
nostrip=yes

do_install() {
	# 1. Extraer directamente en /opt/Heroic con strip de la carpeta raíz
	vmkdir opt/Heroic
	tar -xf "${XBPS_SRCDISTDIR}/${pkgname}-${version}/Heroic-${version}-linux-x64.tar.xz" \
		--strip-components=1 \
		-C "${DESTDIR}/opt/Heroic"

	# 2. Icono del sistema (ya está en ${DESTDIR}/opt/Heroic/resources/...)
	vmkdir usr/share/icons/hicolor/512x512/apps
	cp "${DESTDIR}/opt/Heroic/resources/app.asar.unpacked/build/icon.png" \
		"${DESTDIR}/usr/share/icons/hicolor/512x512/apps/heroic.png"
	chmod 644 "${DESTDIR}/usr/share/icons/hicolor/512x512/apps/heroic.png"

	# 3. Archivo .desktop (el tarball no lo incluye)
	vmkdir usr/share/applications
	cat > "${DESTDIR}/usr/share/applications/heroic.desktop" <<_EOF
[Desktop Entry]
Name=Heroic Games Launcher
Comment=An Open Source Launcher for GOG, Epic Games and Amazon Games
Exec=heroic %U
Icon=heroic
Terminal=false
Type=Application
Categories=Game;
StartupWMClass=Heroic
_EOF

	# 4. Perfil de AppArmor (opcional, por trazabilidad)
	if [ -f "${DESTDIR}/opt/Heroic/resources/apparmor-profile" ]; then
		vmkdir etc/apparmor.d
		cp "${DESTDIR}/opt/Heroic/resources/apparmor-profile" \
			"${DESTDIR}/etc/apparmor.d/heroic"
		chmod 644 "${DESTDIR}/etc/apparmor.d/heroic"
	fi

	# 5. Enlace simbólico para ejecución global
	vmkdir usr/bin
	ln -sf /opt/Heroic/heroic "${DESTDIR}/usr/bin/heroic"

	# 6. Seguridad (Chrome Sandbox): SUID para aislamiento de procesos de Electron
	chmod 4755 "${DESTDIR}/opt/Heroic/chrome-sandbox"
}
