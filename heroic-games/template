# Template file for 'heroic-games-launcher-bin'
pkgname=heroic-games
version=2.22.2
revision=1
archs="x86_64"
build_style=fetch
short_desc="Open Source Launcher for GOG, Epic Games and Amazon Games"
maintainer="Javiercplus"
license="GPL-3.0-only"
homepage="https://heroicgameslauncher.com"
distfiles="https://github.com/Heroic-Games-Launcher/HeroicGamesLauncher/releases/download/v${version}/Heroic-${version}-linux-x64.tar.xz"
checksum=5a1665db55078ab4c070ccadaa46ed4c68f7cdb676d01a0d795256716f3e7e25

# Dependencias mapeadas de Debian a Void Linux
depends="gtk+3 libnotify nss libXScrnSaver libXtst xdg-utils at-spi2-core libuuid libsecret"

# Evita que XBPS intente modificar los binarios ya compilados
nostrip=yes

do_install() {
    # vextract maneja nativamente la extracción de archivos .tar.xz
    vextract "Heroic-${version}-linux-x64.tar.xz"
    
    # 1. Archivos Desktop e Iconos
    # El .tar.xz oficial no incluye integracion con el escritorio de Linux nativa,
    # por lo que generamos el .desktop e instalamos el icono desde los assets de Electron.
    vmkdir usr/share/applications
    cat > "${DESTDIR}/usr/share/applications/heroic.desktop" <<_EOF
[Desktop Entry]
Name=Heroic Games Launcher
Comment=An Open Source Launcher for GOG, Epic Games and Amazon Games
Exec=heroic %U
Icon=heroic
Terminal=false
Type=Application
Categories=Game;
StartupWMClass=Heroic
_EOF

    vmkdir usr/share/icons/hicolor/512x512/apps
    vinstall "Heroic-${version}-linux-x64/resources/app.asar.unpacked/build/icon.png" 644 usr/share/icons/hicolor/512x512/apps heroic.png

    # 2. Perfil de AppArmor (Opcional pero incluido por trazabilidad)
    if [ -f "Heroic-${version}-linux-x64/resources/apparmor-profile" ]; then
        vmkdir etc/apparmor.d
        vinstall "Heroic-${version}-linux-x64/resources/apparmor-profile" 644 etc/apparmor.d heroic
    fi

    # 3. Instalación del núcleo de la aplicación
    # Movemos la carpeta extraída por el tarball a su ubicación final
    vmkdir opt
    mv "Heroic-${version}-linux-x64" "${DESTDIR}/opt/Heroic"

    # 4. Enlace simbólico para ejecución global
    vmkdir usr/bin
    ln -sf /opt/Heroic/heroic "${DESTDIR}/usr/bin/heroic"

    # 5. Seguridad (Chrome Sandbox)
    # Se aplica el permiso SUID para asegurar el aislamiento de procesos de Electron
    chmod 4755 "${DESTDIR}/opt/Heroic/chrome-sandbox"
}
